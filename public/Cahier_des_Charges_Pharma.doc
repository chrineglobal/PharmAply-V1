<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset="utf-8">
    <title>Cahier des Charges - E-Pharmacie</title>
    <style>
        body {
            font-family: 'Calibri', 'Arial', sans-serif;
            color: #333333;
            line-height: 1.6;
            margin: 40px;
        }
        h1 {
            color: #0d9488;
            text-align: center;
            font-size: 28px;
            border-bottom: 2px solid #0d9488;
            padding-bottom: 10px;
        }
        h2 {
            color: #115e59;
            font-size: 22px;
            margin-top: 30px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 5px;
        }
        h3 {
            color: #0f766e;
            font-size: 18px;
            margin-top: 20px;
        }
        ul {
            margin-top: 10px;
            margin-bottom: 10px;
        }
        li {
            margin-bottom: 8px;
        }
        .highlight {
            background-color: #f0fdfa;
            padding: 15px;
            border-left: 4px solid #0d9488;
            margin-top: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
